<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays off everywhere the app actually talks to the network: the update check is https,
  and a manifest URL that is not is refused by the platform rather than by us.

  The one exception is loopback, so that a test build can be pointed at a manifest served on the
  phone itself (adb reverse) without weakening anything reachable from outside the device. The app's
  own HTTP API is unaffected either way — listening on a socket is not subject to this policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
