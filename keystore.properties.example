# Copy to keystore.properties (gitignored) and fill in, or set the equivalent environment
# variables — FREEMAP_TRACKER_STORE_FILE, _STORE_PASSWORD, _KEY_ALIAS, _KEY_PASSWORD — which take
# precedence. Either way the keystore itself lives outside the repository.
#
# There is no Play App Signing safety net for a self-hosted APK: lose this key and every existing
# install has to be uninstalled — recorded tracks and all — before a new one can be installed.
# Back up the keystore and this file somewhere that is not this working copy.

tracker.storeFile=/absolute/path/to/freemap-tracker-release.jks
tracker.storePassword=…
tracker.keyAlias=freemap-tracker
tracker.keyPassword=…
